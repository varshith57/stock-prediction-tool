# Copy to .env and fill in. Never commit .env. See docs/SETUP.md for how to get each value.
APP_ENV=local

# Telegram (docs/SETUP.md section 1)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Postgres: local Docker by default; Neon connection string later (section 2)
DATABASE_URL=postgresql://stockapp:stockapp@localhost:5432/stockapp

# Data lake: local folder now; s3://<bucket> on Cloudflare R2 later (section 3)
LAKE_URI=./data/lake
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
